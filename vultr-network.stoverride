name: Vultr Network Status
desc: 显示当前 Stash 出口 IP、地区、ASN 和运营商

tiles:
  - name: Vultr-Network
    title: 网络出口
    icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Server.png
    collapsed: true

script-providers:
  Vultr-Network:
    url: https://raw.githubusercontent.com/realanv/stash-tile/main/vultr-network.js
    interval: 60
